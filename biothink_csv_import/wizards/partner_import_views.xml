<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_import_wizard_form" model="ir.ui.view">
        <field name="name">biothink.partner.import.wizard.form</field>
        <field name="model">biothink.partner.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar datos">
                <group>
                    <field name="plan_csv_file" filename="file_name"/>
                    <field name="plan_csv_file" invisible="1"/>
                </group>
                <group>
                    <field name="contact_csv_file" filename="file_name"/>
                    <field name="contact_file_name" invisible="1"/>
                </group>
                <group>
                    <field name="accounting_csv_file" filename="accounting_file_name"/>
                    <field name="accounting_file_name" invisible="1"/>
                    <field name="journal_id" required_if="accounting_csv_file"/>
                </group>
                <group>
                    <field name="delimiter"/>
                    <field name="encoding"/>
                    <field name="ignore_errors"/>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el wizard -->
    <record id="action_partner_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Contactos y Asientos</field>
        <field name="res_model">biothink.partner.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- Menú para acceder al wizard -->
    <menuitem id="menu_partner_import_wizard"
          name="Importar Contactos y Asientos"
          parent="contacts.menu_contacts"
          action="action_partner_import_wizard"
          sequence="100"/>

</odoo>
