<odoo>
    <record id="view_purchase_order_whatsapp_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.whatsapp.wizard.form</field>
        <field name="model">purchase.order.whatsapp.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar WhatsApp de pedido de compra">
                <group>
                    <field name="custom_message"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Enviar por WhatsApp" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
