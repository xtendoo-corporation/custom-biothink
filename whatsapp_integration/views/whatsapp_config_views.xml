<odoo>
    <record id="view_whatsapp_config_form" model="ir.ui.view">
        <field name="name">whatsapp.config.form</field>
        <field name="model">whatsapp.config</field>
        <field name="arch" type="xml">
            <form string="Configuración WhatsApp Business">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="whatsapp_api_url"/>
                        <field name="whatsapp_token" password="True"/>
                        <field name="phone_number_id"/>
                        <field name="webhook_verify_token"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="whatsapp_config_action" model="ir.actions.act_window">
        <field name="name">Configuración WhatsApp</field>
        <field name="res_model">whatsapp.config</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_whatsapp_root" name="WhatsApp" sequence="10"/>
    <menuitem id="menu_whatsapp_config" name="Configuración" parent="menu_whatsapp_root" action="whatsapp_config_action"/>
</odoo>
