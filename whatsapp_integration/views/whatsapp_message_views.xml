<odoo>
    <record id="view_whatsapp_message_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="Mensaje WhatsApp">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="message"/>
                        <field name="message_type"/>
                        <field name="status"/>
                        <field name="document_id"/>
                        <field name="whatsapp_message_id"/>
                        <field name="error_message"/>
                        <field name="create_date"/>
                    </group>
                    <footer>
                        <button name="action_send_whatsapp" type="object" string="Enviar por WhatsApp" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="whatsapp_message_action" model="ir.actions.act_window">
        <field name="name">Mensajes WhatsApp</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_whatsapp_message" name="Mensajes" parent="menu_whatsapp_root" action="whatsapp_message_action"/>
</odoo>
