<odoo>
    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla WhatsApp">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="template_body"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="whatsapp_template_action" model="ir.actions.act_window">
        <field name="name">Plantillas WhatsApp</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_whatsapp_template" name="Plantillas" parent="menu_whatsapp_root" action="whatsapp_template_action"/>
</odoo>
